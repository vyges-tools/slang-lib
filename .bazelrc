# SPDX-License-Identifier: Apache-2.0
# Shared flags (C++ standard, -O3, no FP contraction, static archives, macOS minimum): a synced
# copy of vyges-tools/build-config bazel/common.bazelrc. Edit it there, then copy it here; CI
# checks this repository against the pinned build-config tag. Only slang-specific lines follow.
import %workspace%/build-config/common.bazelrc

# slang's pinned source archive is served from this repository (see the file).
common --downloader_config=bazel/downloader.cfg
